<?xml version="1.0" encoding="utf-8"?>
<!-- 标签前的发光节点：外圈淡琥珀光晕 + 内核亮琥珀点。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/lamp_glow" />
            <size android:width="14dp" android:height="14dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/amber_hot" />
        </shape>
    </item>
</layer-list>
