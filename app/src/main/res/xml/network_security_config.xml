<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Android cannot express a runtime, user-entered host in this static XML file.
      Cleartext is therefore enabled at the platform layer for development. The app
      layer restricts HTTP configuration to localhost/loopback or RFC1918 IPv4,
      ApiClientFactory enforces the exact saved origin, and redirects are disabled.
      SettingsActivity also requires an explicit warning acknowledgement for HTTP.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
