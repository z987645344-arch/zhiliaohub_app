<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_gutter">

        <TextView
            style="@style/Archive.Kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_eyebrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/type_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/settings_description"
            android:textColor="@color/steel_blue_dark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/trusted_lan_hint"
            android:textColor="@color/steel_blue_dark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:labelFor="@id/serverUrlInput"
            android:text="@string/address_label"
            android:textColor="@color/ink" />

        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:autofillHints="url"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            android:id="@+id/urlError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/danger"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/httpWarningContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_warning"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/http_warning"
                android:textColor="@color/danger"
                android:textSize="@dimen/type_body"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/httpAcknowledgement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/http_acknowledgement"
                android:textColor="@color/ink" />
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/save_server_address" />

        <TextView
            style="@style/Archive.Kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/settings_recovery_heading" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_recovery_hint"
            android:textColor="@color/steel_blue_dark" />

        <Button
            style="@style/Archive.SecondaryButton"
            android:id="@+id/clearSessionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/clear_session_cookie" />

        <Button
            style="@style/Archive.DangerButton"
            android:id="@+id/resetPairingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/reset_pairing" />

        <Button
            style="@style/Archive.SecondaryButton"
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/back" />
    </LinearLayout>
</ScrollView>
